# ── Copia este archivo como .env y completa los valores ──
# cp .env.example .env

# ── Servidor ──────────────────────────────────────────
PORT=4000
NODE_ENV=development        # Cambiar a "production" en el servidor

# ── Base de datos MySQL ────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=asiste_ing_db

# ── CORS (solo en desarrollo, en producción se ignora) ─
FRONTEND_URL=http://localhost:3001

# ── Credenciales del panel admin ──────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD="TuPasswordSeguro#2025"

# ── JWT ───────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_cadena_secreta_larga_y_aleatoria
